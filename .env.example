# Copy this file to .env and fill in the values. .env is not committed.

# Note: DJANGO_SETTINGS_MODULE is NOT read from this file - set it in the real environment.
# manage.py defaults to cakezone.settings.dev, wsgi.py / asgi.py to cakezone.settings.prod.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# dev only: on/off switch of the debug mode (prod always has DEBUG = False)
DJANGO_DEBUG=true

# Comma separated host names. Dev default: localhost,127.0.0.1,[::1]
# Production example: cakezone.example.com,www.cakezone.example.com
DJANGO_ALLOWED_HOSTS=

# Production, with HTTPS: https://cakezone.example.com,https://www.cakezone.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# prod only: set to false to check the prod settings locally without HTTPS
# DJANGO_SECURE_SSL=true
